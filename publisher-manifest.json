plate-columns: 1fr}\n    .hero-right {border-left: none;border-top: 1px solid var(--border)}\n    .hero-left h1 {font-size: 36px}\n    .faq-grid {grid-template-columns: 1fr}\n    section {padding: 48px 24px}\n    .hero-left {padding: 48px 24px}\n    .hero-right {padding: 32px 24px}\n  }\n</style><nav class=\"nav-wrap\">\n  <div class=\"breadcrumb\"><a href=\"#home\">首页</a> / <a href=\"#plans\">套餐</a> / <a href=\"#faq\">常见问题</a></div>\n  <div class=\"nav-links\">\n    <a href=\"#about\">关于</a>\n    <a href=\"#features\">特性</a>\n    <a href=\"#plans\">套餐</a>\n    <a href=\"#faq\">FAQ</a>\n  </div>\n</nav>\n\n<main id=\"home\">\n  <section class=\"hero\">\n    <div class=\"hero-left\">\n      <h1>alphatechx · 连接，是否<span>通畅</span>？</h1>\n      <p>alphatechx 提供多层级网络加速方案。从日常浏览到游戏专线，总有一个套餐适合你的需求。你想解决什么问题？</p>\n      <a href=\"#plans\" class=\"hero-cta\">查看套餐对比 →</a>\n    </div>\n    <div class=\"hero-right\">\n      <div class=\"info-block\">\n        入门价格\n        <strong>¥15</strong>\n        <span>基础版每月，含 100GB 流量</span>\n      </div>\n      <div class=\"info-block\">\n        设备支持\n        <strong>3-20台</strong>\n        <span>根据套餐支持不同设备数量</span>\n      </div>\n      <div class=\"info-block\">\n        线路类型\n        <strong>IPLC</strong>\n        <span>旗舰版及以上包含专线优化</span>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"features\">\n    <h2>它适合<span>你</span>吗？</h2>\n    <p class=\"section-intro\">不确定哪个版本适合自己？看看下面的场景描述。你属于哪一种用户？</p>\n    <div class=\"cards\">\n      <div class=\"card\">\n        <span class=\"big-num\">01</span>\n        <h3>日常浏览者</h3>\n        <p>偶尔访问海外网站，主要看视频和新闻。</p>\n        <ul>\n          <li>基础版即可满足</li>\n          <li>100GB 足够日常使用</li>\n          <li>支持 3 台设备</li>\n        </ul>\n      </div>\n      <div class=\"card\">\n        <span class=\"big-num\">02</span>\n        <h3>流媒体爱好者</h3>\n        <p>经常观看高清流媒体，对画质有要求。</p>\n        <ul>\n          <li>建议选择旗舰版</li>\n          <li>全节点原生解锁</li>\n          <li>300GB 流量更宽裕</li>\n        </ul>\n      </div>\n      <div class=\"card\">\n        <span class=\"big-num\">03</span>\n        <h3>游戏与团队</h3>\n        <p>需要低延迟游戏加速或多人共享使用。</p>\n        <ul>\n          <li>旗舰版含游戏加速</li>\n          <li>团队版支持 20 台设备</li>\n          <li>专属高带宽节点</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <h2>套餐<span>对比</span></h2>\n    <p class=\"section-intro\">不知道怎么选？直接看横向对比。哪一列最符合你的预算和需求？</p>\n    <div class=\"plans-table-wrap\">\n      <table>\n        <thead>\n          <tr>\n            <th>对比项</th>\n            <th>基础版</th>\n            <th class=\"featured-col\">旗舰版（推荐）</th>\n            <th>团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <td>价格</td>\n            <td>\n              <span class=\"plan-name\">基础版</span>\n              <span class=\"plan-price\">¥15/月</span>\n              <span class=\"plan-annual\">按年付仅需 ¥150/年</span>\n            </td>\n            <td class=\"featured-col\">\n              <span class=\"plan-name\">旗舰版</span>\n              <span class=\"plan-price\">¥35/月</span>\n              <span class=\"plan-annual\">按年付仅需 ¥350/年</span>\n            </td>\n            <td>\n              <span class=\"plan-name\">团队版</span>\n              <span class=\"plan-price\">¥85/月</span>\n              <span class=\"plan-annual\">按年付仅需 ¥850/年</span>\n            </td>\n          </tr>\n          <tr>\n            <td>流量</td>\n            <td>每月 100GB</td>\n            <td class=\"featured-col\">每月 300GB</td>\n            <td>每月 1000GB</td>\n          </tr>\n          <tr>\n            <td>设备数</td>\n            <td>3 台</td>\n            <td class=\"featured-col\">5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <td>流媒体</td>\n            <td>解锁基础流媒体</td>\n            <td class=\"featured-col\">全节点原生流媒体解锁</td>\n            <td>VIP 专属高带宽节点</td>\n          </tr>\n          <tr>\n            <td>线路</td>\n            <td>普通线路节点池</td>\n            <td class=\"featured-col\">IPLC 专线游戏加速优化</td>\n            <td>支持企业定制路由</td>\n          </tr>\n          <tr>\n            <td>支持</td>\n            <td>常规支持</td>\n            <td class=\"featured-col\">7x24 优先工单支持</td>\n            <td>专属客户经理服务</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <h2>还有什么<span>疑问</span>？</h2>\n    <p class=\"section-intro\">关于使用和购买的常见问题。你的问题在这里有答案吗？</p>\n    <div class=\"faq-grid\">\n      <article class=\"faq-item\">\n        <h3>流量用完了怎么办？</h3>\n        <p>套餐流量用完后，你可以等待次月自动重置，或者升级到更高流量的套餐。比如从基础版升级到旗舰版，流量将提升至 300GB。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>可以随时更换套餐吗？</h3>\n        <p>支持随时升级套餐，按差价补费即可生效。降级套餐则需在当前周期结束后生效。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>支持哪些设备？</h3>\n        <p>支持主流桌面和移动平台。不同套餐支持的同时在线设备数不同，基础版 3 台，旗舰版 5 台，团队版 20 台。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>年付和月付有什么区别？</h3>\n        <p>年付相当于以优惠价格一次性购买 10 个月的使用期，赠送 2 个月。例如旗舰版年付仅需 ¥350，相比月付节省 ¥70。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>专线游戏加速是什么？</h3>\n        <p>旗舰版包含 IPLC 专线优化，针对游戏连接提供更低延迟的线路，适合对网络延迟敏感的在线游戏。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>团队版可以定制路由吗？</h3>\n        <p>可以。团队版支持企业定制路由，并有专属客户经理协助配置，适合有特定网络需求的团队使用。</p>\n      </article>\n    </div>\n  </section>\n</main>\n\n<footer>\n  <p>© alphatechx. 本页面信息仅供参考。</p>\n</footer>",
